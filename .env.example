# 1. 填写 API Key（必填）
# LLM_API_KEY=sk-xxx

# 2. 选择提供商
# LLM_PROVIDER=deepseek    # deepseek（默认）| openai | local

# 3. 模型地址（DeepSeek / OpenAI 用默认地址，不用填）
#    local 必须填写，如：http://127.0.0.1:8080/v1
# LLM_BASE_URL=https://api.deepseek.com/v1

# 4. 模型名称（DeepSeek / OpenAI 用默认模型，不用填）
#    local 必须填写，如：qwen2.5-7b
# LLM_MODEL=deepseek-v4-flash
