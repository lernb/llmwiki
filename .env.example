# LLM Wiki Configuration
# Copy this file to .env and fill in your values, OR use one of the alternatives below.

# ─── API Key 设置（三选一）───
#
# 方式 A: 系统环境变量（推荐 Windows 用户）
#   打开 CMD 运行:
#      setx DEEPSEEK_API_KEY "sk-你的key"
#   然后重启终端。Key 存在注册表加密存储。
#
# 方式 B: Windows Credential Manager（最安全，需手动添加）
#   打开 「Credential Manager」→「Windows Credentials」→「Add a generic credential」
#   目标名: reasonix/llmwiki/deepseek-api-key
#   用户名: (任意)
#   密码:   sk-你的key
#
# 方式 C: 直接写本文件（最方便，但明文存储）
DEEPSEEK_API_KEY=sk-your-key-here

# ─── 可选配置 ───
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash
# PORT=8000
# HOST=127.0.0.1
