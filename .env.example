# ─── LLM Wiki 配置 ──────────────────────────────────────────────────

# API Key（DeepSeek / OpenAI 需要）
DEEPSEEK_API_KEY=sk-your-key-here

# ─── 模型提供商 ─────────────────────────────────────────────────────
# deepseek  : DeepSeek API（默认）
# openai    : OpenAI API
# local     : 本地模型（llama.cpp / Ollama / LM Studio 等 OpenAI 兼容接口）
# LLM_PROVIDER=deepseek

# ─── 本地模型（LLM_PROVIDER=local 时配置）──────────────────────────
# llama.cpp 默认地址: http://127.0.0.1:8080/v1
# Ollama 默认地址:    http://127.0.0.1:11434/v1
# LM Studio 默认地址: http://127.0.0.1:1234/v1
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=llama-3.2-3b

# ─── 可选配置 ──────────────────────────────────────────────────────
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash
# PORT=8000
# HOST=127.0.0.1
